generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auditlog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entity      String
  entityId    Int?
  description String?
  createdAt   DateTime @default(now())
  user        user?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "auditlog_userId_fkey")
}

model category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  description String?
  imageUrl    String?    @db.LongText
  updatedAt   DateTime?
  menuitem    menuitem[]
}

model expense {
  id            Int      @id @default(autoincrement())
  title         String
  amount        Float
  category      String?
  receiver      String?
  date          DateTime @default(now())
  description   String?  @db.Text
  paymentMethod String?
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  createdBy     user?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model receiptSettings {
  id         Int      @id @default(1)
  name       String   @default("My Restaurant")
  address    String?  @db.LongText
  phone      String?  @db.LongText
  email      String?
  logoUrl    String?  @db.LongText
  vatNumber  String?
  footerText String?  @db.LongText
  updatedAt  DateTime @updatedAt
}

model address {
  id         Int       @id @default(autoincrement())
  customerId Int       @db.UnsignedInt
  name       String
  district   String
  street     String
  phone      String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      order[]

  @@index([customerId])
}

model ingredient {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  unit          String
  stockQuantity Float           @default(0)
  minStockLevel Float           @default(0)
  costPerUnit   Float           @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  menuitembom   menuitembom[]
  stockmovement stockmovement[]
  purchaseline  purchaseline[]
}

model menu {
  id             Int              @id @default(autoincrement())
  title          String
  url            String
  icon           String
  order          Int              @default(0)
  isActive       Boolean          @default(true)
  moduleKey      MenuModuleKey    @default(RESTAURANT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  roleMenuAccess roleMenuAccess[]
  submenu        submenu[]

  @@index([moduleKey, isActive, order])
}

enum MenuModuleKey {
  CORE
  RESTAURANT
  ACCOUNTING
  ACCESS_CONTROL
}

model menuitem {
  id                           Int                            @id @default(autoincrement())
  name                         String
  description                  String?                        @db.Text
  costPrice                    Float?
  price                        Float
  tax                          Float                          @default(5)
  discountType                 String?
  discountValue                Float                          @default(0)
  imageUrl                     String?                        @db.LongText
  isAvailable                  Boolean                        @default(true)
  isSellable                   Boolean                        @default(true)
  isPurchasable                Boolean                        @default(false)
  isRecommended                Boolean                        @default(false)
  isComposite                  Boolean                        @default(false)
  compositePricing             String                         @default("fixed") // sum | fixed
  options                      Json?
  categoryId                   Int
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @default(now()) @updatedAt
  category                     category                       @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  menuitembom                  menuitembom[]
  orderitem                    orderitem[]
  discountAdvertisementProduct discountAdvertisementProduct[]
  compositeComponents          menuitemcomponent[]            @relation("CompositeParent")
  usedInComposites             menuitemcomponent[]            @relation("CompositeChild")
  cartitem                     cartitem[]
  purchaseLines                purchaseline[]

  @@index([categoryId], map: "MenuItem_categoryId_fkey")
}

model menuitemcomponent {
  id              Int      @id @default(autoincrement())
  compositeItemId Int
  componentItemId Int
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  compositeItem   menuitem @relation("CompositeParent", fields: [compositeItemId], references: [id], onDelete: Cascade)
  componentItem   menuitem @relation("CompositeChild", fields: [componentItemId], references: [id], onDelete: Cascade)

  @@unique([compositeItemId, componentItemId])
  @@index([componentItemId])
}

model discountAdvertisement {
  id              Int                            @id @default(autoincrement())
  type            String
  title           String?
  description     String?                        @db.Text
  imageUrl        String?                        @db.LongText
  url             String?
  discountPercent Float?
  startAt         DateTime?
  endAt           DateTime?
  isActive        Boolean                        @default(true)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  products        discountAdvertisementProduct[]
}

model discountAdvertisementProduct {
  id                      Int                   @id @default(autoincrement())
  discountAdvertisementId Int
  menuItemId              Int
  discountAdvertisement   discountAdvertisement @relation(fields: [discountAdvertisementId], references: [id], onDelete: Cascade)
  menuitem                menuitem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([discountAdvertisementId, menuItemId])
  @@index([menuItemId])
}

model menuitembom {
  id               Int        @id @default(autoincrement())
  menuItemId       Int
  ingredientId     Int
  quantityRequired Float
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  ingredient       ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  menuitem         menuitem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId], map: "menuitembom_ingredientId_fkey")
}

model notification {
  id              Int      @id @default(autoincrement())
  title           String
  message         String
  role            String?
  orderId         Int?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  userId          Int?
  customerId      Int?
  senderId        Int?
  senderName      String?
  senderAvatarUrl String?  @db.Text
  user            user?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          user?    @relation("sentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderId])
}

model order {
  id               Int              @id @default(autoincrement())
  orderNumber      String?          @unique @db.VarChar(32)
  companyId        Int?             @db.UnsignedInt
  currencyId       Int?             @db.UnsignedInt
  status           String           @default("pending")
  total            Float            @default(0)
  taxAmount        Float            @default(0)
  subTotal         Float            @default(0)
  discountAmount   Float            @default(0)
  discountType     String?
  discountValue    Float            @default(0)
  tableId          Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  customerName     String?
  notes            String?
  customerPhone    String?
  customerId       Int?             @db.UnsignedInt
  userId           Int?
  orderType        String           @default("dine-in")
  source           String           @default("pos")
  accountingStatus String           @default("pending") @db.VarChar(16)
  journalEntryId   Int?             @unique @db.UnsignedInt
  accountedAt      DateTime?
  accountingError  String?          @db.Text
  addressId        Int?
  address          address?         @relation(fields: [addressId], references: [id])
  customer         customers?       @relation(fields: [customerId], references: [id])
  company          companies?       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency         currencies?      @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalEntry     journal_entries? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  table            table?           @relation(fields: [tableId], references: [id], onDelete: NoAction)
  user             user?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderitem        orderitem[]

  payment payment?

  @@index([addressId])
  @@index([tableId], map: "Order_tableId_fkey")
  @@index([customerId], map: "order_customerId_fkey")
  @@index([userId], map: "order_userId_fkey")
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([companyId])
  @@index([currencyId])
  @@index([accountingStatus])
}

model orderitem {
  id         Int      @id @default(autoincrement())
  quantity   Int      @default(1)
  unitPrice  Float
  tax        Float    @default(0)
  orderId    Int
  menuItemId Int
  menuitem   menuitem @relation(fields: [menuItemId], references: [id], onDelete: NoAction)
  order      order    @relation(fields: [orderId], references: [id], onDelete: NoAction)

  @@index([menuItemId], map: "OrderItem_menuItemId_fkey")
  @@index([orderId], map: "OrderItem_orderId_fkey")
}

model payment {
  id           Int       @id @default(autoincrement())
  orderId      Int       @unique
  amount       Float
  method       String
  status       String    @default("pending")
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  internalRef  String?   @unique
  phone        String?
  providerName String?
  providerRef  String?   @unique
  order        order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  roleMenuAccess roleMenuAccess[]
  user           user[]
}

model roleMenuAccess {
  id                Int                 @id @default(autoincrement())
  roleId            Int
  menuId            Int
  canView           Boolean             @default(true)
  canAdd            Boolean             @default(false)
  canEdit           Boolean             @default(false)
  canDelete         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  menu              menu                @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role              role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleSubMenuAccess roleSubMenuAccess[]

  @@unique([roleId, menuId])
  @@index([menuId], map: "roleMenuAccess_menuId_fkey")
}

model roleSubMenuAccess {
  id               Int            @id @default(autoincrement())
  roleMenuAccessId Int
  subMenuId        Int
  canView          Boolean        @default(true)
  canAdd           Boolean        @default(false)
  canEdit          Boolean        @default(false)
  canDelete        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  roleMenuAccess   roleMenuAccess @relation(fields: [roleMenuAccessId], references: [id], onDelete: Cascade)
  submenu          submenu        @relation(fields: [subMenuId], references: [id], onDelete: Cascade)

  @@unique([roleMenuAccessId, subMenuId])
  @@index([subMenuId], map: "roleSubMenuAccess_subMenuId_fkey")
}

model stockmovement {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  type         String
  quantity     Float
  note         String?
  purchaseId   Int?
  createdAt    DateTime   @default(now())
  ingredient   ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchase     purchase?  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([ingredientId], map: "stockmovement_ingredientId_fkey")
  @@index([purchaseId])
}

model purchase {
  id             Int             @id @default(autoincrement())
  purchaseNumber String          @unique
  supplierId     Int             @db.UnsignedInt
  companyId      Int?            @db.UnsignedInt
  journalEntryId Int?            @unique @db.UnsignedInt
  purchaseDate   DateTime        @db.Date
  totalAmount    Float           @default(0)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplier       vendors         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines          purchaseline[]
  stockmovements stockmovement[]

  @@index([supplierId])
  @@index([companyId])
  @@index([purchaseDate])
}

model purchaseline {
  id           Int        @id @default(autoincrement())
  purchaseId   Int
  ingredientId Int?
  menuItemId   Int?
  description  String     @db.VarChar(255)
  unit         String     @db.VarChar(32)
  quantity     Float
  unitCost     Float
  lineTotal    Float
  purchase     purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient   ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  menuItem     menuitem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([ingredientId])
  @@index([menuItemId])
}

model submenu {
  id                Int                 @id @default(autoincrement())
  menuId            Int
  title             String
  url               String
  order             Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  roleSubMenuAccess roleSubMenuAccess[]
  menu              menu                @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId], map: "submenu_menuId_fkey")
}

model table {
  id          Int       @id @default(autoincrement())
  number      Int       @unique
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  name        String?
  description String?   @db.Text
  qrCode      String    @unique
  updatedAt   DateTime? @updatedAt
  order       order[]
  cart        cart[]
}

model cart {
  id        Int        @id @default(autoincrement())
  tableId   Int
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  table     table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items     cartitem[]

  @@index([tableId, status])
}

model cartitem {
  id         Int      @id @default(autoincrement())
  cartId     Int
  menuItemId Int
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem   menuitem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([cartId, menuItemId])
  @@index([menuItemId])
}

model user {
  id                Int            @id @default(autoincrement())
  email             String         @unique
  password          String
  username          String?        @unique
  posPin            String?
  createdAt         DateTime       @default(now())
  fullName          String
  isActive          Boolean        @default(true)
  phone             String?        @unique
  address           String?        @db.Text
  dateOfBirth       DateTime?
  gender            String?
  avatarUrl         String?        @db.LongText
  authProvider      String?        @default("local")
  googleId          String?        @unique
  facebookId        String?        @unique
  fcmToken          String?        @db.Text
  fcmTokenUpdatedAt DateTime?
  updatedAt         DateTime       @default(now()) @updatedAt
  roleId            Int
  auditlog          auditlog[]
  notification      notification[]
  sentNotifications notification[] @relation("sentNotifications")
  expense           expense[]
  order             order[]
  role              role           @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@index([roleId], map: "User_roleId_fkey")
}

model account_types {
  id                Int                          @id @default(autoincrement()) @db.UnsignedInt
  name              String                       @unique(map: "uq_account_types_name") @db.VarChar(64)
  internal_group    account_types_internal_group
  normal_balance    account_types_normal_balance
  report_type       account_types_report_type
  sequence          Int                          @default(10) @db.UnsignedInt
  chart_of_accounts chart_of_accounts[]
}

model bank_accounts {
  id                Int                @id @default(autoincrement()) @db.UnsignedInt
  company_id        Int                @db.UnsignedInt
  bank_id           Int                @db.UnsignedInt
  institution_name  String             @db.VarChar(128)
  account_name      String             @db.VarChar(128)
  account_number    String?            @db.VarChar(64)
  iban              String?            @db.VarChar(34)
  currency_id       Int                @db.UnsignedInt
  gl_account_id     Int?               @db.UnsignedInt
  payment_method_id Int?               @db.UnsignedInt
  journal_id        Int?               @db.UnsignedInt
  is_active         Boolean            @default(true)
  created_at        DateTime           @default(now()) @db.Timestamp(0)
  updated_at        DateTime           @default(now()) @db.Timestamp(0)
  banks             banks              @relation(fields: [bank_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ba_bank")
  companies         companies          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ba_company")
  currencies        currencies         @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ba_currency")
  chart_of_accounts chart_of_accounts? @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ba_gl")
  payment_methods   payment_methods?   @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ba_payment_method")
  journals          journals?          @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ba_journal")
  vendor_payments   vendor_payments[]

  @@unique([bank_id, account_number], map: "uq_bank_accounts_number")
  @@index([company_id], map: "fk_ba_company")
  @@index([currency_id], map: "fk_ba_currency")
  @@index([gl_account_id], map: "fk_ba_gl")
  @@index([payment_method_id], map: "fk_ba_payment_method")
  @@index([journal_id], map: "fk_ba_journal")
}

model banks {
  id            Int             @id @default(autoincrement()) @db.UnsignedInt
  name          String          @unique(map: "uq_banks_name") @db.VarChar(128)
  swift_bic     String?         @db.VarChar(11)
  address       String?         @db.VarChar(255)
  city          String?         @db.VarChar(128)
  country       String?         @db.VarChar(128)
  phone         String?         @db.VarChar(32)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamp(0)
  updated_at    DateTime        @default(now()) @db.Timestamp(0)
  bank_accounts bank_accounts[]
}

model chart_of_accounts {
  id                                                             Int                      @id @default(autoincrement()) @db.UnsignedInt
  company_id                                                     Int                      @db.UnsignedInt
  code                                                           String                   @db.VarChar(16)
  name                                                           String                   @db.VarChar(128)
  account_type_id                                                Int                      @db.UnsignedInt
  parent_id                                                      Int?                     @db.UnsignedInt
  currency_id                                                    Int?                     @db.UnsignedInt
  is_reconcilable                                                Boolean                  @default(false)
  allow_manual_entry                                             Boolean                  @default(true)
  is_active                                                      Boolean                  @default(true)
  notes                                                          String?                  @db.Text
  created_at                                                     DateTime                 @default(now()) @db.Timestamp(0)
  updated_at                                                     DateTime                 @default(now()) @db.Timestamp(0)
  bank_accounts                                                  bank_accounts[]
  payment_methods                                                payment_methods[]
  companies                                                      companies                @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_coa_company")
  currencies                                                     currencies?              @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_coa_currency")
  chart_of_accounts                                              chart_of_accounts?       @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_coa_parent")
  other_chart_of_accounts                                        chart_of_accounts[]      @relation("chart_of_accountsTochart_of_accounts")
  account_types                                                  account_types            @relation(fields: [account_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_coa_type")
  customer_invoice_lines                                         customer_invoice_lines[]
  customer_invoices                                              customer_invoices[]
  customers                                                      customers[]
  journal_items                                                  journal_items[]
  journals_journals_default_credit_account_idTochart_of_accounts journals[]               @relation("journals_default_credit_account_idTochart_of_accounts")
  journals_journals_default_debit_account_idTochart_of_accounts  journals[]               @relation("journals_default_debit_account_idTochart_of_accounts")
  products_products_expense_account_idTochart_of_accounts        products[]               @relation("products_expense_account_idTochart_of_accounts")
  products_products_income_account_idTochart_of_accounts         products[]               @relation("products_income_account_idTochart_of_accounts")
  taxes                                                          taxes[]
  vendor_bill_lines                                              vendor_bill_lines[]
  vendor_bills                                                   vendor_bills[]
  vendors                                                        vendors[]
  vendor_advances                                                vendor_advances[]

  @@unique([company_id, code], map: "uq_coa_company_code")
  @@index([currency_id], map: "fk_coa_currency")
  @@index([parent_id], map: "idx_coa_parent")
  @@index([account_type_id], map: "idx_coa_type")
}

model companies {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  name              String              @db.VarChar(128)
  legal_name        String?             @db.VarChar(255)
  tax_id            String?             @db.VarChar(64)
  currency_id       Int                 @db.UnsignedInt
  address           String?             @db.VarChar(255)
  city              String?             @db.VarChar(128)
  country           String?             @db.VarChar(128)
  phone             String?             @db.VarChar(32)
  email             String?             @db.VarChar(128)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @db.Timestamp(0)
  bank_accounts     bank_accounts[]
  chart_of_accounts chart_of_accounts[]
  currencies        currencies          @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_currency")
  customer_invoices customer_invoices[]
  customer_receipts customer_receipts[]
  customers         customers[]
  fiscal_years      fiscal_years[]
  journal_entries   journal_entries[]
  journals          journals[]
  order             order[]
  vendor_bills      vendor_bills[]
  vendor_payments   vendor_payments[]
  vendor_advances   vendor_advances[]
  vendors           vendors[]

  @@index([currency_id], map: "fk_companies_currency")
}

model currencies {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  code              String              @unique(map: "uq_currencies_code") @db.Char(3)
  name              String              @db.VarChar(64)
  symbol            String              @default("") @db.VarChar(8)
  decimal_places    Int                 @default(2) @db.UnsignedTinyInt
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @db.Timestamp(0)
  bank_accounts     bank_accounts[]
  chart_of_accounts chart_of_accounts[]
  companies         companies[]
  customer_invoices customer_invoices[]
  customer_receipts customer_receipts[]
  customers         customers[]
  journal_items     journal_items[]
  journals          journals[]
  order             order[]
  vendor_bills      vendor_bills[]
  vendor_payments   vendor_payments[]
  vendor_advances   vendor_advances[]
  vendors           vendors[]
}

model customer_invoice_lines {
  id                Int               @id @default(autoincrement()) @db.UnsignedInt
  invoice_id        Int               @db.UnsignedInt
  sequence          Int               @default(10) @db.UnsignedInt
  product_id        Int?              @db.UnsignedInt
  description       String            @db.VarChar(255)
  quantity          Decimal           @default(1.0000) @db.Decimal(15, 4)
  unit_price        Decimal           @default(0.0000) @db.Decimal(15, 4)
  discount_percent  Decimal           @default(0.0000) @db.Decimal(7, 4)
  tax_id            Int?              @db.UnsignedInt
