model vendor_advances {
  id                 Int                           @id @default(autoincrement()) @db.UnsignedInt
  company_id         Int                           @db.UnsignedInt
  vendor_id          Int                           @db.UnsignedInt
  currency_id        Int                           @db.UnsignedInt
  payment_id         Int                           @unique @db.UnsignedInt
  advance_account_id Int                           @db.UnsignedInt
  original_amount    Decimal                       @db.Decimal(15, 2)
  remaining_amount   Decimal                       @db.Decimal(15, 2)
  state              String                        @default("open") @db.VarChar(16)
  created_at         DateTime                      @default(now()) @db.Timestamp(0)
  updated_at         DateTime                      @default(now()) @db.Timestamp(0)
  companies          companies                     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_va_company")
  vendors            vendors                       @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_va_vendor")
  currencies         currencies                    @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_va_currency")
  vendor_payments    vendor_payments               @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_va_payment")
  chart_of_accounts  chart_of_accounts             @relation(fields: [advance_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_va_account")
  applications       vendor_advance_applications[]

  @@index([vendor_id, currency_id, state], map: "idx_va_available")
  @@index([advance_account_id], map: "fk_va_account")
}

model vendor_advance_applications {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  advance_id      Int             @db.UnsignedInt
  bill_id         Int             @db.UnsignedInt
  amount          Decimal         @db.Decimal(15, 2)
  applied_at      DateTime        @default(now()) @db.Timestamp(0)
  vendor_advances vendor_advances @relation(fields: [advance_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vaa_advance")
  vendor_bills    vendor_bills    @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vaa_bill")

  @@unique([advance_id, bill_id], map: "uq_vaa_advance_bill")
  @@index([bill_id], map: "fk_vaa_bill")
}

model vendors {
  id                   Int                  @id @default(autoincrement()) @db.UnsignedInt
  company_id           Int                  @db.UnsignedInt
  vendor_code          String?              @db.VarChar(16)
  name                 String               @db.VarChar(128)
  partner_type         vendors_partner_type @default(company)
  tax_id               String?              @db.VarChar(64)
  email                String?              @db.VarChar(128)
  phone                String?              @db.VarChar(32)
  address              String?              @db.VarChar(255)
  city                 String?              @db.VarChar(128)
  country              String?              @db.VarChar(128)
  currency_id          Int?                 @db.UnsignedInt
  payment_term_id      Int?                 @db.UnsignedInt
  payable_account_id   Int?                 @db.UnsignedInt
  default_bank_account String?              @db.VarChar(64)
  notes                String?              @db.Text
  is_active            Boolean              @default(true)
  created_at           DateTime             @default(now()) @db.Timestamp(0)
  updated_at           DateTime             @default(now()) @db.Timestamp(0)
  vendor_bills         vendor_bills[]
  vendor_payments      vendor_payments[]
  vendor_advances      vendor_advances[]
  purchases            purchase[]
  chart_of_accounts    chart_of_accounts?   @relation(fields: [payable_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ven_ap")
  companies            companies            @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ven_company")
  currencies           currencies?          @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ven_currency")
  payment_terms        payment_terms?       @relation(fields: [payment_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ven_terms")

  @@unique([company_id, vendor_code], map: "uq_vendors_company_code")
  @@index([payable_account_id], map: "fk_ven_ap")
  @@index([currency_id], map: "fk_ven_currency")
  @@index([payment_term_id], map: "fk_ven_terms")
  @@index([name], map: "idx_vendors_name")
}

