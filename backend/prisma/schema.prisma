  vendor_advances     vendor_advances[]
  bank_accounts       bank_accounts?        @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_bank")
  companies           companies             @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_company")
  currencies          currencies            @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_currency")
  journal_entries     journal_entries?      @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_je")
  journals            journals              @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_journal")
  payment_methods     payment_methods       @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_method")
  fiscal_periods      fiscal_periods?       @relation(fields: [fiscal_period_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_period")
  vendors             vendors               @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vp_vendor")

  @@unique([company_id, payment_number], map: "uq_vp_company_number")
  @@index([bank_account_id], map: "fk_vp_bank")
  @@index([currency_id], map: "fk_vp_currency")
  @@index([journal_entry_id], map: "fk_vp_je")
  @@index([journal_id], map: "fk_vp_journal")
  @@index([payment_method_id], map: "fk_vp_method")
  @@index([fiscal_period_id], map: "fk_vp_period")
  @@index([payment_date], map: "idx_vp_date")
  @@index([vendor_id], map: "idx_vp_vendor")
