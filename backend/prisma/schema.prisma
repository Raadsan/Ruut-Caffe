  id                Int               @id @default(autoincrement()) @db.UnsignedInt
  receipt_id        Int               @db.UnsignedInt
  invoice_id        Int               @db.UnsignedInt
  allocated_amount  Decimal           @db.Decimal(15, 2)
  allocated_at      DateTime          @default(now()) @db.Timestamp(0)
  customer_invoices customer_invoices @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ra_invoice")
  customer_receipts customer_receipts @relation(fields: [receipt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ra_receipt")

  @@unique([receipt_id, invoice_id], map: "uq_ra_receipt_invoice")
  @@index([invoice_id], map: "fk_ra_invoice")
}

model taxes {
  id                                       Int                      @id @default(autoincrement()) @db.UnsignedInt
  name                                     String                   @unique(map: "uq_taxes_name") @db.VarChar(64)
  tax_scope                                taxes_tax_scope          @default(both)
  rate_percent                             Decimal                  @default(0.0000) @db.Decimal(7, 4)
  tax_account_id                           Int?                     @db.UnsignedInt
  price_includes_tax                       Boolean                  @default(false)
  is_active                                Boolean                  @default(true)
  created_at                               DateTime                 @default(now()) @db.Timestamp(0)
  updated_at                               DateTime                 @default(now()) @db.Timestamp(0)
  customer_invoice_lines                   customer_invoice_lines[]
  products_products_purchase_tax_idTotaxes products[]               @relation("products_purchase_tax_idTotaxes")
  products_products_sale_tax_idTotaxes     products[]               @relation("products_sale_tax_idTotaxes")
  chart_of_accounts                        chart_of_accounts?       @relation(fields: [tax_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_taxes_account")
  vendor_bill_lines                        vendor_bill_lines[]

  @@index([tax_account_id], map: "fk_taxes_account")
}

model vendor_bill_lines {
  id                 Int               @id @default(autoincrement()) @db.UnsignedInt
  bill_id            Int               @db.UnsignedInt
  sequence           Int               @default(10) @db.UnsignedInt
  product_id         Int?              @db.UnsignedInt
  description        String            @db.VarChar(255)
  quantity           Decimal           @default(1.0000) @db.Decimal(15, 4)
  unit_price         Decimal           @default(0.0000) @db.Decimal(15, 4)
  discount_percent   Decimal           @default(0.0000) @db.Decimal(7, 4)
  tax_id             Int?              @db.UnsignedInt
  expense_account_id Int               @db.UnsignedInt
  subtotal           Decimal?          @db.Decimal(15, 2)
  vendor_bills       vendor_bills      @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vbl_bill")
  chart_of_accounts  chart_of_accounts @relation(fields: [expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vbl_expense")
  products           products?         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vbl_product")
  taxes              taxes?            @relation(fields: [tax_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vbl_tax")

  @@index([expense_account_id], map: "fk_vbl_expense")
  @@index([product_id], map: "fk_vbl_product")
  @@index([tax_id], map: "fk_vbl_tax")
  @@index([bill_id], map: "idx_vbl_bill")
}

model vendor_bills {
  id                          Int                           @id @default(autoincrement()) @db.UnsignedInt
  company_id                  Int                           @db.UnsignedInt
  document_type               vendor_bills_document_type    @default(bill)
  bill_number                 String?                       @db.VarChar(32)
  vendor_id                   Int                           @db.UnsignedInt
  vendor_reference            String?                       @db.VarChar(64)
  journal_id                  Int                           @db.UnsignedInt
  fiscal_period_id            Int?                          @db.UnsignedInt
  bill_date                   DateTime                      @db.Date
  received_date               DateTime?                     @db.Date
  due_date                    DateTime?                     @db.Date
  payment_term_id             Int?                          @db.UnsignedInt
  currency_id                 Int                           @db.UnsignedInt
  exchange_rate               Decimal                       @default(1.000000) @db.Decimal(15, 6)
  payable_account_id          Int                           @db.UnsignedInt
  reversed_bill_id            Int?                          @db.UnsignedInt
  state                       vendor_bills_state            @default(draft)
  payment_state               vendor_bills_payment_state    @default(not_paid)
  amount_untaxed              Decimal                       @default(0.00) @db.Decimal(15, 2)
  amount_tax                  Decimal                       @default(0.00) @db.Decimal(15, 2)
  amount_total                Decimal                       @default(0.00) @db.Decimal(15, 2)
  amount_paid                 Decimal                       @default(0.00) @db.Decimal(15, 2)
  amount_due                  Decimal                       @default(0.00) @db.Decimal(15, 2)
  journal_entry_id            Int?                          @db.UnsignedInt
  notes                       String?                       @db.Text
  posted_at                   DateTime?                     @db.Timestamp(0)
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                      @default(now()) @db.Timestamp(0)
  payment_allocations         payment_allocations[]
  vendor_advance_applications vendor_advance_applications[]
  vendor_bill_lines           vendor_bill_lines[]
  chart_of_accounts           chart_of_accounts             @relation(fields: [payable_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_ap")
  companies                   companies                     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_company")
  currencies                  currencies                    @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_currency")
  journal_entries             journal_entries?              @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_je")
  journals                    journals                      @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_journal")
  fiscal_periods              fiscal_periods?               @relation(fields: [fiscal_period_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_period")
  vendor_bills                vendor_bills?                 @relation("vendor_billsTovendor_bills", fields: [reversed_bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_reversed")
  other_vendor_bills          vendor_bills[]                @relation("vendor_billsTovendor_bills")
  payment_terms               payment_terms?                @relation(fields: [payment_term_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_terms")
  vendors                     vendors                       @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vb_vendor")

  @@unique([company_id, bill_number], map: "uq_vb_company_number")
  @@unique([vendor_id, vendor_reference], map: "uq_vb_vendor_reference")
  @@index([payable_account_id], map: "fk_vb_ap")
  @@index([currency_id], map: "fk_vb_currency")
  @@index([journal_entry_id], map: "fk_vb_je")
  @@index([journal_id], map: "fk_vb_journal")
  @@index([fiscal_period_id], map: "fk_vb_period")
  @@index([reversed_bill_id], map: "fk_vb_reversed")
  @@index([payment_term_id], map: "fk_vb_terms")
  @@index([bill_date], map: "idx_vb_date")
  @@index([state, payment_state], map: "idx_vb_state")
  @@index([vendor_id], map: "idx_vb_vendor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
